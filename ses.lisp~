;;; -*- Mode: lisp; coding: utf-8 -*-

(in-package "JRM-CODE-PROJECT")

(defun ses-smtp-endpoint ()
  (let ((smtp-host (or (getenv "SES_SMTP_HOST") "email-smtp.us-east-1.amazonaws.com"))
        (smtp-port (or (getenv "SES_SMTP_PORT") "587"))
        (smtp-user (or (getenv "SES_SMTP_USER") ""))
        (smtp-pass (or (getenv "SES_SMTP_PASS") "")))
    (values smtp-host smtp-port smtp-user smtp-pass)))
